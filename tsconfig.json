{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["esnext"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    // Node runs the tests as TypeScript, so imports end in .ts.
    "allowImportingTsExtensions": true
  },
  "include": ["test/**/*.ts"]
}
